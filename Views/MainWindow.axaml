<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordManagerUI.Views.MainWindow"
        Title="Password Manager"
        Width="600" Height="700"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Border CornerRadius="16"
            Background="#1C1C1C"
            Padding="32"
            BorderBrush="#444444"
            BorderThickness="1">
        <StackPanel Spacing="24">

            <!-- Title -->
            <TextBlock Text="Password Manager"
                      FontSize="32"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Foreground="#EAEAEA"/>

            <!-- Account Name -->
            <TextBlock Text="Account Name"
                      FontSize="14"
                      Foreground="#B0B0B0"/>
            <Border CornerRadius="8"
                    Background="#282828"
                    BorderBrush="#444444"
                    BorderThickness="1">
                <TextBox x:Name="AccountInput"
                         Watermark="e.g., Gmail, GitHub"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12"
                         Foreground="#EAEAEA"
                         FontSize="16"
                         HorizontalAlignment="Stretch"/>
            </Border>

            <!-- Email or Username -->
            <TextBlock Text="Email or Username"
                      FontSize="14"
                      Foreground="#B0B0B0"/>
            <Border CornerRadius="8"
                    Background="#282828"
                    BorderBrush="#444444"
                    BorderThickness="1">
                <TextBox x:Name="EmailInput"
                         Watermark="you@example.com"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12"
                         Foreground="#EAEAEA"
                         FontSize="16"
                         HorizontalAlignment="Stretch"/>
            </Border>

            <!-- Password Length -->
            <TextBlock Text="Password Length"
                      FontSize="14"
                      Foreground="#B0B0B0"/>
            <Border CornerRadius="8"
                    Background="#282828"
                    BorderBrush="#444444"
                    BorderThickness="1">
                <TextBox x:Name="LengthInput"
                         Watermark="16"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12"
                         Foreground="#EAEAEA"
                         FontSize="16"
                         HorizontalAlignment="Stretch"/>
            </Border>

            <!-- Generate Button -->
            <Button x:Name="GenerateButton"
                    Content="Generate Password"
                    HorizontalAlignment="Stretch"
                    Padding="16"
                    FontWeight="Bold"
                    Background="#5A69FF"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    Height="50"
                    CornerRadius="8"
                    Click="OnGenerateClick"/>

            <!-- Result Skeleton -->
            <TextBlock x:Name="Output"
                      Margin="0,24,0,0"
                      TextWrapping="Wrap"
                      FontSize="18"
                      Foreground="#EAEAEA"/>

            <!-- Result Info -->
            <StackPanel x:Name="ResultInfo" Spacing="10" IsVisible="False">
                <TextBlock Text="Generated Password:"
                          FontWeight="Bold"
                          Foreground="#EAEAEA"/>
                <TextBlock x:Name="GeneratedPassword"
                          FontSize="16"
                          Foreground="#5A69FF"/>
                <TextBlock x:Name="SavePath"
                          FontSize="14"
                          Foreground="#A9A9A9"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
