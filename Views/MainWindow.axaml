<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordManagerUI.Views.MainWindow"
        Title="Password Manager" Width="400" Height="400">
  <StackPanel Margin="20" Spacing="10">

    <TextBlock Text="Account Name:"/>
    <TextBox Name="AccountInput"/>

    <TextBlock Text="Email or Username:"/>
    <TextBox Name="EmailInput"/>

    <TextBlock Text="Password Length:"/>
    <TextBox Name="LengthInput"/>

    <Button Content="Generate Password" Click="OnGenerateClick"/>

    <TextBlock Name="Output" TextWrapping="Wrap" Margin="0,10,0,0"/>

  </StackPanel>
</Window>
